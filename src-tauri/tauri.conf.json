{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openbio",
  "version": "0.1.25",
  "identifier": "software.is-a.openbio",
  "build": {
    "beforeDevCommand": "npm run prisma:generate && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./scripts/download-micromamba.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "openbio",
        "width": 1400,
        "height": 900,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/micromamba*"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/OpenBio-OS/Laboratory-Information-Management-System/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1QkY5QkZCNkYyN0ZBRjIKUldUeStpZHYrNXUvVmJFNkpmV3FHWEY1UXh3MGlYUVVaM1Y1Y1M4dUJNU3JRamgyNkFsK2FGaHkK"
    }
  }
}
